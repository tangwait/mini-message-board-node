<html>
  <head>
    <title>Homepage</title>
    <link rel="stylesheet" href="/style.css">
  </head>
  <body>
    <%- include('navbar', {links: links}) %>

    <ul>
      <% messages.forEach(message => { %>
        <li>
          <strong><%= message.username %>:</strong> <%= message.text %> <em>(<%= message.created_at %>)</em>
        </li>
      <% }); %>
    </ul>
  </body>
</html>
